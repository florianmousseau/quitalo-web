{
	"name": "quitalo-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Marketing site for Quitalo, the local-first companion for French private landlords.",
	"license": "MIT",
	"author": "Florian Mousseau <florian.mousseau@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/florianmousseau/quitalo-web.git"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"dup": "jscpd src --format typescript,javascript --threshold 2",
		"gate": "npm run format:check && npm run lint && npm run check && npm run knip && npm run dup",
		"prepare": "simple-git-hooks",
		"indexnow": "node bin/indexnow.mjs"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{ts,js,mjs,astro}": [
			"prettier --write",
			"eslint --fix --max-warnings 0"
		],
		"*.{json,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"astro": "^7.1.6"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.0.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"globals": "^17.8.0",
		"jscpd": "^5.0.14",
		"knip": "^6.31.0",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.65.0"
	}
}
