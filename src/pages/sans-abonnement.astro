---
import Base from '../layouts/Base.astro';
import CardGrid from '../components/CardGrid.astro';
import Faq from '../components/Faq.astro';
import { APP_URL, BRAND } from '../consts';

// Each promise carries the technical reason it holds, because a promise a
// visitor cannot verify is worth nothing. The pricing wording must stay in
// step with /cgv and llms.txt: free up to three properties, then a one-off
// lifetime licence.
const promises = [
	{
		title: 'Aucun compte à créer',
		body:
			'L’application s’ouvre et fonctionne. Il n’y a pas de formulaire d’inscription, ' +
			'pas d’email à confirmer, pas de mot de passe à retenir. Rien à résilier non plus.'
	},
	{
		title: 'Aucune période d’essai',
		body:
			'Rien ne s’arrête au septième jour. Les fonctions que vous utilisez aujourd’hui ' +
			'fonctionneront de la même manière dans six mois, sans compte à rebours.'
	},
	{
		title: 'Aucun document retenu',
		body:
			'Quittances, avis d’échéance, relevés et courriers sont fabriqués dans votre ' +
			'navigateur, sur votre appareil. Il n’y a aucun serveur à qui demander ' +
			'l’autorisation de les télécharger : techniquement, personne ne peut vous les retenir.'
	},
	{
		title: 'Aucun compte supprimé pour inactivité',
		body:
			'Un bailleur dont tout se passe bien n’ouvre pas son outil pendant des mois. ' +
			'Ici c’est sans conséquence : vos données sont sur votre appareil, pas sur un ' +
			'serveur qui fait le ménage dans ses comptes dormants.'
	},
	{
		title: 'Aucune donnée revendue',
		body:
			'Pas parce que nous sommes vertueux, mais parce qu’il n’existe pas de serveur où ' +
			'les envoyer. Les données de vos locataires ne quittent jamais votre navigateur.'
	},
	{
		title: 'Aucun abonnement',
		body:
			'Gratuit jusqu’à trois biens. Au-delà, une licence à vie de 39 €, mises à jour ' +
			'comprises : un paiement, une fois, et l’outil est à vous.'
	}
];

const faq = [
	{
		q: 'Faut-il payer pour télécharger une quittance ?',
		a:
			'Non. La quittance de loyer est gratuite par la loi (article 21 de la loi du 6 ' +
			'juillet 1989), et Quitalo la génère dans votre navigateur : il n’y a pas de ' +
			'paiement à franchir pour récupérer un document que vous venez de produire.'
	},
	{
		q: 'Que se passe-t-il si je n’ouvre pas Quitalo pendant un an ?',
		a:
			'Rien. Il n’y a pas de compte à expirer. Vos données vous attendent dans votre ' +
			'navigateur, et votre sauvegarde chiffrée reste là où vous l’avez rangée.'
	},
	{
		q: 'Quitalo est-il vraiment gratuit ?',
		a:
			'Gratuit jusqu’à trois biens, sans limite de durée et sans publicité. Au-delà de ' +
			'trois biens, une licence à vie de 39 €, payée une seule fois. Il n’y a pas ' +
			'd’abonnement, à aucun palier.'
	},
	{
		q: 'Et si je veux partir ?',
		a:
			'Vous exportez une archive de chaque bail : les quittances et relevés en PDF, une ' +
			'page à ouvrir dans n’importe quel navigateur et vos données dans un format ' +
			'ouvert. Elle se lit sans Quitalo, ce qui est bien le but.'
	}
];

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a }
	}))
};

const title = `Sans abonnement, sans compte, sans mur au téléchargement - ${BRAND}`;
const description =
	'Ce que Quitalo ne fera jamais : pas de compte, pas de période d’essai, pas de ' +
	'document retenu contre paiement, pas de compte supprimé pour inactivité. Gratuit ' +
	'jusqu’à trois biens, puis licence à vie de 39 €.';
---

<Base {title} {description}>
	<script
		type="application/ld+json"
		slot="head"
		is:inline
		set:html={JSON.stringify(structuredData)}
	/>

	<section class="wrap intro">
		<h1>Ce que Quitalo ne fera jamais</h1>
		<p class="lede">
			Beaucoup d’outils de gestion locative annoncent un document gratuit, puis demandent un
			abonnement au moment de le télécharger, une fois le formulaire rempli. C’est l’inverse de ce
			que nous construisons. Voici nos engagements, et la raison technique pour laquelle chacun
			tient.
		</p>
	</section>

	<section class="wrap">
		<CardGrid items={promises} />
	</section>

	<section class="wrap">
		<h2>Ce que ça coûte, précisément</h2>
		<p>
			Gratuit jusqu’à trois biens, ce qui couvre l’immense majorité des bailleurs particuliers.
			Au-delà, une <strong>licence à vie de 39 €</strong>, mises à jour comprises et sans
			abonnement. Le détail contractuel est dans les
			<a href="/cgv">conditions de vente</a>.
		</p>
		<p>
			Un outil gratuit sans serveur n’a rien à revendre : c’est ce qui rend la promesse tenable dans
			la durée, plutôt que financée par vos données. Le fonctionnement est détaillé sur <a
				href="/#donnees">vos données</a
			>.
		</p>
	</section>

	<section class="wrap">
		<h2>Ce que Quitalo ne fait pas</h2>
		<p>
			Un engagement n’a de valeur que si l’on dit aussi ce qui manque. Quitalo ne rédige pas votre
			bail, ne fait pas d’état des lieux photo et ne propose pas de signature électronique : cette
			dernière suppose un tiers de confiance distant, donc un serveur, ce qui contredirait tout le
			reste de cette page. Si ces fonctions vous sont indispensables, un autre outil vous servira
			mieux.
		</p>
	</section>

	<section class="wrap">
		<h2>Questions fréquentes</h2>
		<Faq items={faq} />
	</section>

	<section class="wrap closing">
		<h2>Rien à créer, rien à confirmer</h2>
		<p>
			L’application s’ouvre dans le navigateur. Ajoutez un logement, un locataire, un bail : la
			première quittance est prête, et elle est à vous.
		</p>
		<a href={APP_URL} class="btn btn-primary">Ouvrir l’application</a>
	</section>
</Base>

<style>
	.intro {
		margin-top: 3rem;
	}

	h1 {
		font-size: clamp(1.8rem, 4.5vw, 2.6rem);
		margin: 0 0 1rem;
	}

	.lede {
		font-size: 1.15rem;
		color: var(--text-soft);
		max-width: 44rem;
		margin: 0;
	}

	section {
		margin-top: 3rem;
	}

	h2 {
		font-size: 1.5rem;
		margin: 0 0 1rem;
	}

	.closing {
		text-align: center;
		background: var(--accent-soft);
		border-radius: var(--radius);
		padding: 2.5rem 1.5rem;
	}

	.closing p {
		max-width: 38rem;
		margin: 0 auto 1.5rem;
	}
</style>
