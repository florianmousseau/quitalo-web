---
import Base from '../layouts/Base.astro';
import CardGrid from '../components/CardGrid.astro';
import Faq from '../components/Faq.astro';
import { APP_URL, BRAND, DEFINITION, DEMO_URL } from '../consts';
import { faq, features } from '../content/product';

// Mirrors the visible feature and FAQ blocks below; both are derived from the
// same arrays so the markup and the structured data cannot drift apart.
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareApplication',
			name: BRAND,
			applicationCategory: 'BusinessApplication',
			operatingSystem: 'Web',
			url: APP_URL,
			description: DEFINITION,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'EUR'
			},
			featureList: features.map((f) => f.title)
		},
		{
			'@type': 'FAQPage',
			mainEntity: faq.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.a
				}
			}))
		}
	]
};
---

<Base>
	<script
		type="application/ld+json"
		slot="head"
		is:inline
		set:html={JSON.stringify(structuredData)}
	/>

	<section class="hero">
		<div class="wrap">
			<h1>Vos locations en ordre.<br />Vos données chez vous.</h1>
			<p class="lede">
				Quitalo est le compagnon gratuit du petit bailleur : quittances conformes, suivi des loyers,
				révision IRL et lettres d'impayés. Sans compte, sans abonnement, sans serveur.
			</p>
			<div class="cta">
				<a href={APP_URL} class="btn btn-primary">Ouvrir l'application</a>
				<a href={DEMO_URL} class="btn btn-ghost">Essayer la démo</a>
			</div>
			<p class="badges">
				Gratuit. Sans compte. Vos données restent dans votre navigateur. La démo est un jeu fictif :
				elle n'enregistre rien.
			</p>
		</div>
	</section>

	<section id="fonctionnalites" class="wrap">
		<h2>Tout ce que la gestion d'un logement demande</h2>
		<CardGrid items={features} level={3} />
	</section>

	<section id="donnees" class="wrap">
		<h2>Les données de vos locataires ne transitent par aucun serveur</h2>
		<p>
			Tout vit dans votre navigateur. La sauvegarde est un fichier chiffré que vous gardez où vous
			voulez, y compris sur votre propre Google Drive. Pas de compte à créer, rien à résilier.
		</p>
		<p>
			Côté RGPD, cela change tout : vous restez l'unique responsable des données de vos locataires.
			Quitalo n'en voit jamais aucune, parce qu'il n'a pas de serveur où les envoyer.
		</p>
	</section>

	<section class="wrap">
		<h2>Pensé pour le bailleur particulier</h2>
		<p>
			Un à cinq logements, loués vides ou meublés, sans agence : baux d'habitation de la loi du 6
			juillet 1989, en France. Pas de SCI à l'IS, pas de baux commerciaux, pas d'usine à gaz.
		</p>
	</section>

	<section class="wrap">
		<h2>Questions fréquentes</h2>
		<Faq items={faq} />
	</section>

	<section class="wrap closing">
		<h2>Créez votre premier bail en cinq minutes</h2>
		<p>
			L'application s'ouvre dans le navigateur, sans inscription. Ajoutez un logement, un locataire,
			un bail : la première quittance est prête. Pour regarder d'abord, la démo montre deux baux
			déjà remplis, avec un impayé et un paiement partiel.
		</p>
		<div class="cta">
			<a href={APP_URL} class="btn btn-primary">Ouvrir l'application</a>
			<a href={DEMO_URL} class="btn btn-ghost">Essayer la démo</a>
		</div>
	</section>
</Base>

<style>
	.hero {
		background: var(--carte);
		border-bottom: 1px solid var(--bord);
		padding: 4.5rem 0 4rem;
		text-align: center;
	}

	.hero h1 {
		font-size: clamp(2rem, 5vw, 3.1rem);
		margin: 0 0 1rem;
	}

	.lede {
		font-size: 1.2rem;
		color: var(--encre-douce);
		max-width: 42rem;
		margin: 0 auto 1.8rem;
	}

	.cta {
		display: flex;
		gap: 0.8rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.badges {
		margin-top: 1.4rem;
		font-size: 0.95rem;
		color: var(--encre-douce);
	}

	section {
		margin-top: 3.5rem;
	}

	h2 {
		font-size: 1.65rem;
		margin: 0 0 1rem;
	}

	.closing {
		text-align: center;
		background: var(--regle-fond);
		border-radius: var(--rayon);
		padding: 2.5rem 1.5rem;
	}

	.closing p {
		max-width: 38rem;
		margin: 0 auto 1.5rem;
	}
</style>
