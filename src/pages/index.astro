---
import Base from '../layouts/Base.astro';
import { APP_URL, BRAND, DEFINITION } from '../consts';

const features = [
	{
		title: 'La quittance en dix secondes',
		body:
			'Marquez un loyer payé, téléchargez la quittance PDF : période, loyer et charges ' +
			'détaillés, mentions de l’article 21 de la loi du 6 juillet 1989. Gratuite, ' +
			'comme la loi l’exige. Avis d’échéance et relevé annuel des encaissements inclus.'
	},
	{
		title: 'Le suivi des loyers, mois par mois',
		body:
			'Une grille par bail : payé, partiel, en retard, y compris les paiements ' +
			'partiels. Le premier impayé se voit tout de suite, pas trois mois plus tard.'
	},
	{
		title: 'La révision IRL sans calculette',
		body:
			'Les indices INSEE sont inclus. Quitalo calcule la révision plafonnée de votre ' +
			'bail, prépare la lettre de notification et met le loyer à jour.'
	},
	{
		title: 'Les impayés, sans panique',
		body:
			'Une échelle graduée prête à l’emploi : relance amiable, puis mise en demeure ' +
			'fondée sur l’article 1344-1 du code civil, avec les lettres PDF et la marche à suivre.'
	}
];

const faq = [
	{
		q: 'La quittance de loyer est-elle obligatoire ?',
		a:
			'Oui, dès que le locataire la demande, et elle doit être gratuite (article 21 de la ' +
			'loi du 6 juillet 1989). Quitalo la génère en PDF, loyer et charges détaillés.'
	},
	{
		q: 'Comment réviser un loyer avec l’IRL ?',
		a:
			'Une fois par an, à la date prévue au bail, dans la limite de la variation de ' +
			'l’IRL du trimestre de référence. Quitalo fait le calcul avec les indices INSEE ' +
			'et prépare la lettre de notification.'
	},
	{
		q: 'Que faire au premier loyer impayé ?',
		a:
			'Réagir vite et par écrit : relance amiable d’abord, puis mise en demeure en ' +
			'recommandé avec accusé de réception. Quitalo fournit les lettres et le calendrier.'
	},
	{
		q: 'Où sont stockées mes données ?',
		a:
			'Dans votre navigateur, sur votre appareil. Vous exportez quand vous voulez une ' +
			'sauvegarde chiffrée que vous gardez où vous voulez. Rien n’est envoyé à Quitalo.'
	}
];

// Mirrors the visible feature and FAQ blocks below; both are derived from the
// same arrays so the markup and the structured data cannot drift apart.
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'SoftwareApplication',
			name: BRAND,
			applicationCategory: 'BusinessApplication',
			operatingSystem: 'Web',
			url: APP_URL,
			description: DEFINITION,
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'EUR'
			},
			featureList: features.map((f) => f.title)
		},
		{
			'@type': 'FAQPage',
			mainEntity: faq.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.a
				}
			}))
		}
	]
};
---

<Base>
	<script
		type="application/ld+json"
		slot="head"
		is:inline
		set:html={JSON.stringify(structuredData)}
	/>

	<section class="hero">
		<div class="wrap">
			<h1>Vos locations en ordre.<br />Vos données chez vous.</h1>
			<p class="lede">
				Quitalo est le compagnon gratuit du petit bailleur : quittances conformes, suivi des loyers,
				révision IRL et lettres d’impayés. Sans compte, sans abonnement, sans serveur.
			</p>
			<div class="cta">
				<a href={APP_URL} class="btn btn-primary">Ouvrir l’application</a>
				<a href="#fonctionnalites" class="btn btn-ghost">Voir les fonctionnalités</a>
			</div>
			<p class="badges">Gratuit. Sans compte. Vos données restent dans votre navigateur.</p>
		</div>
	</section>

	<section id="fonctionnalites" class="wrap">
		<h2>Tout ce que la gestion d’un logement demande</h2>
		<div class="grid">
			{
				features.map((f) => (
					<article class="card">
						<h3>{f.title}</h3>
						<p>{f.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<section id="donnees" class="wrap">
		<h2>Les données de vos locataires ne transitent par aucun serveur</h2>
		<p>
			Tout vit dans votre navigateur. La sauvegarde est un fichier chiffré que vous gardez où vous
			voulez, y compris sur votre propre Google Drive. Pas de compte à créer, rien à résilier.
		</p>
		<p>
			Côté RGPD, cela change tout : vous restez l’unique responsable des données de vos locataires.
			Quitalo n’en voit jamais aucune, parce qu’il n’a pas de serveur où les envoyer.
		</p>
	</section>

	<section class="wrap">
		<h2>Pensé pour le bailleur particulier</h2>
		<p>
			Un à cinq logements, loués vides ou meublés, sans agence : baux d’habitation de la loi du 6
			juillet 1989, en France. Pas de SCI à l’IS, pas de baux commerciaux, pas d’usine à gaz.
		</p>
	</section>

	<section id="tarif" class="wrap">
		<h2>Gratuit pour la plupart des bailleurs</h2>
		<p>
			Quitalo est <strong>gratuit</strong>, sans compte et sans publicité. Quand un outil est
			gratuit, on est souvent le produit. Ici, non : il n’y a pas de serveur, donc rien à revendre,
			et vos données ne quittent jamais votre navigateur.
		</p>
		<p>
			À terme, le modèle restera simple : <strong>gratuit jusqu’à trois biens</strong>, ce qui
			couvre l’immense majorité des bailleurs particuliers. Au-delà, une
			<strong>licence à vie de 39 €</strong>, mises à jour comprises et sans abonnement : vous
			possédez l’outil, il tourne chez vous, pour toujours.
		</p>
		<p>
			Les bailleurs qui l’utilisent dès maintenant gardent un avantage fondateur. Le détail est dans
			les <a href="/cgv">conditions de vente</a>.
		</p>
	</section>

	<section class="wrap">
		<h2>Questions fréquentes</h2>
		{
			faq.map((item) => (
				<details>
					<summary>{item.q}</summary>
					<p>{item.a}</p>
				</details>
			))
		}
	</section>

	<section class="wrap closing">
		<h2>Créez votre premier bail en cinq minutes</h2>
		<p>
			L’application s’ouvre dans le navigateur, sans inscription. Ajoutez un logement, un locataire,
			un bail : la première quittance est prête.
		</p>
		<a href={APP_URL} class="btn btn-primary">Ouvrir l’application</a>
	</section>
</Base>

<style>
	.hero {
		background: var(--bg-raised);
		border-bottom: 1px solid var(--border);
		padding: 4.5rem 0 4rem;
		text-align: center;
	}

	.hero h1 {
		font-size: clamp(2rem, 5vw, 3.1rem);
		margin: 0 0 1rem;
	}

	.lede {
		font-size: 1.2rem;
		color: var(--text-soft);
		max-width: 42rem;
		margin: 0 auto 1.8rem;
	}

	.cta {
		display: flex;
		gap: 0.8rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.badges {
		margin-top: 1.4rem;
		font-size: 0.95rem;
		color: var(--text-soft);
	}

	section {
		margin-top: 3.5rem;
	}

	h2 {
		font-size: 1.65rem;
		margin: 0 0 1rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1rem;
	}

	.card {
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.2rem 1.3rem;
	}

	.card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}

	.card p {
		margin: 0;
		color: var(--text-soft);
	}

	details {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-raised);
		padding: 0.8rem 1.1rem;
		margin-bottom: 0.7rem;
	}

	summary {
		font-weight: 600;
		cursor: pointer;
	}

	details p {
		margin: 0.7rem 0 0.2rem;
		color: var(--text-soft);
	}

	.closing {
		text-align: center;
		background: var(--accent-soft);
		border-radius: var(--radius);
		padding: 2.5rem 1.5rem;
	}

	.closing p {
		max-width: 38rem;
		margin: 0 auto 1.5rem;
	}
</style>
